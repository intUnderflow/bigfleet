{
  "uid": "bigfleet-scaletest",
  "title": "BigFleet — Scale Test",
  "tags": ["bigfleet", "scaletest"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "panels": [
    {
      "id": 100, "type": "row", "title": "SLO live verdict (ADR-0014 / 0017 / 0018)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 101, "type": "stat", "title": "Internal binding latency p99 (per-Pod, ADR-0018) — SLO ≤ 5 s",
      "description": "BigFleet-internal binding latency (the harness fake provider returns instantly; ADR-0018: this is *not* user-facing latency, just BigFleet's contribution). Per-Pod histogram emitted by the bigfleet-scaletest-pod-shim. CR-mode opt-out profiles have no shim → metric is empty by design; runner skips the gate via -1 sentinel (ADR-0017).",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(histogram_quantile(0.99, sum by (le) (rate(bigfleet_scaletest_pod_bind_latency_seconds_bucket[5m]))))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "CR-mode (no shim)", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 4}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 102, "type": "stat", "title": "Cycle duration p99 — envelope ≤ 5 s",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(histogram_quantile(0.99, sum by (le, pod) (rate(bigfleet_shard_cycle_duration_seconds_bucket[5m]))))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 4}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 103, "type": "stat", "title": "Operator rollup p99 — SLO ≤ 1 s",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(bigfleet_operator_rollup_duration_seconds_bucket[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 104, "type": "stat", "title": "Operator ack p99 — SLO ≤ 12 s",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(bigfleet_operator_acknowledge_duration_seconds_bucket[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 12}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 105, "type": "stat", "title": "Sustained load — SLO ≥ 99.9 %",
      "description": "loadgenCRsActive divided by the load-driver's target. The runner gates on min_over_time of this over the last 5 min of soak; this panel shows the live ratio. Anything < 99.9 % means the load fell off mid-soak and the SLOs are measured against an under-loaded shard.",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(scaletest_loadgen_cr_active) / scalar(sum(scaletest_loadgen_cr_target))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.999}]}, "noValue": "load-driver target metric not exposed (older builds: see panel 1)"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 106, "type": "stat", "title": "Shards reporting cycle — SLO = replicas",
      "description": "Counts shard pods publishing bigfleet_shard_cycle_duration_seconds. Less than shard.replicas means at least one shard is crash-looping or wedged; the per-pod max(by pod) aggregation in cycle p99 silently excludes missing pods so this gate catches them.",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(rate(bigfleet_shard_cycle_duration_seconds_count[2m]) > 0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 107, "type": "stat", "title": "Coordinator FSM error rate — SLO ≤ 0.1 %",
      "description": "FSM Apply error rate on the coordinator leader. > 0.001 means Raft is rejecting commands or the FSM is returning errors — coordinator-side correctness violation.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(sum(rate(bigfleet_coordinator_apply_total{outcome=\"error\"}[5m])) or vector(0)) / clamp_min(sum(rate(bigfleet_coordinator_apply_total[5m])), 1e-9)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.0005}, {"color": "red", "value": 0.001}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 108, "type": "stat", "title": "Operator outbox drops / sec — SLO 0",
      "description": "Operator session-outbox drops. > 0 means the operator stream lost frames silently. Different from rollup/ack timeout — these are dropped messages, full stop.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(bigfleet_operator_outbox_dropped_total[1m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.001}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 1, "type": "stat", "title": "Active CRs",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(scaletest_loadgen_cr_active)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "timeseries", "title": "CR creates / sec",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(scaletest_loadgen_cr_created_total[1m]))", "refId": "A", "legendFormat": "creates/s"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "Shortfalls",
      "description": "bigfleet_shard_shortfalls — unsatisfied demand the shard couldn't resolve this cycle. Reported, not gated by pass() — shortfalls are a bigfleet_shard_shortfalls_aged escalation signal, not a binary fail.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(bigfleet_shard_shortfalls)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 109, "type": "stat", "title": "Failed machines",
      "description": "bigfleet_shard_inventory_machines{state=\"Failed\"}. Includes M38 spot/hardware-fault simulator + execute-path Bootstrap timeouts (ADR-0019 followup). Reported, not gated.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(bigfleet_shard_inventory_machines{state=\"Failed\"}) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 200, "type": "row", "title": "Latency timeseries (with SLO threshold lines)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "collapsed": false
    },
    {
      "id": 201, "type": "timeseries", "title": "Internal binding latency p99 — SLO line at 5 s (ADR-0018 in-process tier)",
      "description": "ADR-0018: BigFleet's internal contribution only (fake provider returns instantly). Two curves: (A) per-Pod from the pod-shim — empty in CR-mode profiles by design (see ADR-0017); (B) fingerprint fan-out — diagnostic only, p99 is a histogram_quantile-on-stale-data artefact (327.68 s = +Inf bucket boundary) once the ramp ends, not a real latency. Neither curve gates the run in CR-mode.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "max(histogram_quantile(0.99, sum by (le) (rate(bigfleet_scaletest_pod_bind_latency_seconds_bucket[5m]))))", "refId": "A", "legendFormat": "per-Pod (ADR-0017)"},
        {"expr": "max(histogram_quantile(0.99, sum by (le, pod) (rate(bigfleet_shard_provisioning_latency_seconds_bucket[5m]))))", "refId": "B", "legendFormat": "fingerprint fan-out (legacy / diagnostic)"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}, "drawStyle": "line"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "Shard cycle p99 (worst shard) — envelope line at 5 s",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(histogram_quantile(0.99, sum by (le, pod) (rate(bigfleet_shard_cycle_duration_seconds_bucket[5m]))))", "refId": "A", "legendFormat": "cycle p99"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}, "color": {"mode": "thresholds"}}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "Cycle p99 by phase",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max by (phase) (histogram_quantile(0.99, sum by (le, pod, phase) (rate(bigfleet_shard_cycle_phase_duration_seconds_bucket[5m]))))", "refId": "A", "legendFormat": "{{phase}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "Operator rollup p99 — SLO line at 1 s",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(bigfleet_operator_rollup_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "rollup p99"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "Operator acknowledge p99 — SLO line at 12 s",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(bigfleet_operator_acknowledge_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "ack p99"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 12}]}, "color": {"mode": "thresholds"}}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Provisioning latency (fingerprint fan-out — diagnostic)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "max(histogram_quantile(0.50, sum by (le, pod) (rate(bigfleet_shard_provisioning_latency_seconds_bucket[5m]))))", "refId": "A", "legendFormat": "p50"},
        {"expr": "max(histogram_quantile(0.99, sum by (le, pod) (rate(bigfleet_shard_provisioning_latency_seconds_bucket[5m]))))", "refId": "B", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "Coordinator apply ops/sec by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (outcome) (rate(bigfleet_coordinator_apply_total[1m]))", "refId": "A", "legendFormat": "{{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 11, "type": "stat", "title": "Coordinator pending instructions",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 38},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(bigfleet_coordinator_pending_instructions)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 12, "type": "stat", "title": "Shards reporting cycle",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 38},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(count by (pod) (bigfleet_shard_cycle_duration_seconds_count{component=\"shard\"}))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 13, "type": "stat", "title": "Coordinator Raft term",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 38},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(bigfleet_coordinator_raft_term)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 14, "type": "timeseries", "title": "Per-shard inventory",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (pod) (bigfleet_shard_inventory_machines)", "refId": "A", "legendFormat": "{{pod}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 300, "type": "row", "title": "Phase 1 sub-paths (ADR-0019 / M44.4)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 46},
      "collapsed": false
    },
    {
      "id": 301, "type": "timeseries", "title": "Phase 1 sub-path mean duration",
      "description": "ADR-0019: per-sub-path attribution of Phase 1 wall-clock. take is the head-cursor walk; takeCoLocated is the Same-rack bucket pick (the cloud-only hot path the operator's owner-grouping forces every Pod-derived Need through); takeSpread is the strict-spread bucket pick. After M44.4's optimisation, the cached bucketing + per-bucket head cursors should drop takeCoLocated mean to sub-millisecond.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 47},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(bigfleet_shard_phase1_take_duration_seconds_sum[2m]) / rate(bigfleet_shard_phase1_take_duration_seconds_count[2m])", "refId": "A", "legendFormat": "{{path}} mean"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 302, "type": "timeseries", "title": "Phase 1 sub-path call rate",
      "description": "Calls per second by sub-path. takeCoLocated dominating reflects the Pod → CR → Same(rack) translation at scale; take dominating reflects single-archetype profiles without sameRack.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 47},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(bigfleet_shard_phase1_calls_total[2m])", "refId": "A", "legendFormat": "{{path}} /s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 303, "type": "timeseries", "title": "Phase 1 sub-path CPU share (sum/sec)",
      "description": "How much wall-clock per second of soak each sub-path consumes. ≈1.0 means the sub-path is fully saturating one shard CPU; ≪1 means it's fine. Pre-M44.4 takeCoLocated landed near 1.0 at scaleway-50k.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 55},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(bigfleet_shard_phase1_take_duration_seconds_sum[2m])", "refId": "A", "legendFormat": "{{path}} s/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1}, "overrides": []}
    },
    {
      "id": 304, "type": "timeseries", "title": "Phase 1 pool build duration (cache miss cost)",
      "description": "buildPoolSource time per (state, fingerprint). Cached after first build per cycle; high values here mean pool merging+sorting (multi-instance-type profiles) is dominating, not the take path.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 55},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(bigfleet_shard_phase1_pool_build_duration_seconds_bucket[2m])))", "refId": "A", "legendFormat": "p99"},
        {"expr": "sum(rate(bigfleet_shard_phase1_pool_build_duration_seconds_sum[2m])) / sum(rate(bigfleet_shard_phase1_pool_build_duration_seconds_count[2m]))", "refId": "B", "legendFormat": "mean"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 400, "type": "row", "title": "Pipeline drop-off (M44.4)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 63},
      "collapsed": false
    },
    {
      "id": 401, "type": "timeseries", "title": "Pod-mode chain stage cumulative — per stage",
      "description": "From load-driver Pod creates down to fake-Node bindings. Watch the gap between consecutive stages — that's where the chain throttles. Right after gate-cleared the curves should track each other; if they diverge, identify the rate-limited stage by which curve flattens first.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(scaletest_loadgen_cr_created_total) - sum(scaletest_loadgen_cr_deleted_total)", "refId": "A", "legendFormat": "1) Pods alive (created - deleted)"},
        {"expr": "sum(bigfleet_scaletest_pod_shim_pods_marked_unschedulable_total{outcome=\"patched\"})", "refId": "B", "legendFormat": "2) marked Unschedulable by pod-shim"},
        {"expr": "sum(bigfleet_unschedulable_pod_controller_reconciles_total{outcome=\"cr_created\"})", "refId": "C", "legendFormat": "3) CRs created by UPC"},
        {"expr": "sum(bigfleet_shard_actions_total{kind=\"Bootstrap\"})", "refId": "D", "legendFormat": "4) Bootstrap actions emitted (shard)"},
        {"expr": "sum(bigfleet_shard_inventory_machines{state=\"Configured\"})", "refId": "E", "legendFormat": "5) Configured machines"},
        {"expr": "sum(bigfleet_scaletest_pod_shim_fake_nodes_created_total)", "refId": "F", "legendFormat": "6) fake Nodes created"},
        {"expr": "sum(bigfleet_scaletest_pod_shim_pod_bind_attempts_total{outcome=\"success\"})", "refId": "G", "legendFormat": "7) Pod binds (success)"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 402, "type": "timeseries", "title": "Pipeline stage rate (events / sec)",
      "description": "Per-stage events per second. Equal rates = chain in steady-state; the slowest curve here is the throttling stage.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(scaletest_loadgen_cr_created_total[1m]))", "refId": "A", "legendFormat": "1) Pod creates/s"},
